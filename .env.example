# ==============================================================================
# Database Connections (Supabase PostgreSQL + Prisma 6)
# ==============================================================================
# DATABASE_URL: Runtime traffic using Supabase connection pooler (Transaction mode, port 6543)
# Set connection_limit=5 (Render starter) or connection_limit=1 (Vercel serverless)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"

# DIRECT_URL: Direct database connection (Session mode, port 5432)
# Required by Prisma 6 for migrations, db push, and schema introspection
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# ==============================================================================
# Security & Authentication (Server-Side Secrets — NEVER expose with NEXT_PUBLIC_)
# ==============================================================================
# Strong random secret for cryptographic HMAC-SHA256 JWT signing (at least 32 characters)
AUTH_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"

# Initial Admin Account Seed (Used once on first boot if no admin exists)
ADMIN_MOBILE="9876543210"
ADMIN_EMAIL="admin@homemart4u.com"
ADMIN_PASSWORD="set_strong_admin_password_here"

# Webhook Authentication Secret (For verifying signed bank/gateway webhooks)
PAYMENT_WEBHOOK_SECRET="replace_with_a_strong_webhook_hmac_secret"

# ==============================================================================
# Application Base URLs
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Split Deployment Settings (Frontend on Vercel, Node.js API on Render)
# Set RENDER_BACKEND_URL in Vercel to proxy /api requests to Render
RENDER_BACKEND_URL="https://homemart4u-backend.onrender.com"
# Set FRONTEND_URL and ALLOWED_ORIGINS in Render to allow requests from Vercel
FRONTEND_URL="https://homemart4u.vercel.app"
ALLOWED_ORIGINS="https://homemart4u.vercel.app,http://localhost:3000"

# ==============================================================================
# Feature Flags
# ==============================================================================
ORDER_SIMULATION_ENABLED="false"
PAYMENTS_ENABLED="true"
MARKETING_NOTIFICATIONS_ENABLED="true"

# ==============================================================================
# Shop Operational Details (Public)
# ==============================================================================
NEXT_PUBLIC_SHOP_NAME="homemart4u"
NEXT_PUBLIC_SHOP_PHONE="+91 90355 26638"
NEXT_PUBLIC_SHOP_PHONE_NUMBER="9035526638"
NEXT_PUBLIC_SHOP_EMAIL="support@homemart4u.com"
NEXT_PUBLIC_SHOP_ADDRESS="Srinivaspur Road, Mulbagal, Karnataka 563131"
NEXT_PUBLIC_SHOP_LAT="13.1642"
NEXT_PUBLIC_SHOP_LNG="78.3951"

# Customer Support Hotline Configuration
SUPPORT_PHONE_NUMBER="+91 90355 26638"
NEXT_PUBLIC_SUPPORT_PHONE_NUMBER="+91 90355 26638"

# ==============================================================================
# UPI Payment Gateway Configuration
# ==============================================================================
# Registered Merchant VPA and Name (Axis Bank / Google Pay for Business)
UPI_VPA="7975137618@okbizaxis"
UPI_MERCHANT_NAME="Fresh Chicken Centre"
UPI_PAYEE_NAME="Fresh Chicken Centre"
UPI_MCC="5422"
NEXT_PUBLIC_UPI_MERCHANT_NAME="Fresh Chicken Centre"

