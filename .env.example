# homemart4u Platform Environment Configuration Example
# Copy to .env for deployment

# Database Connection (PostgreSQL connection string)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Authentication Secret (Strong random secret for JWT signing)
AUTH_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"

# Admin Initial Provisioning (Keep confidential and set secure unique values)
ADMIN_MOBILE="7022461700"
ADMIN_EMAIL="admin@homemart4u.in"
ADMIN_PASSWORD="set_strong_admin_password_here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
ORDER_SIMULATION_ENABLED="false"
PAYMENTS_ENABLED="true"
MARKETING_NOTIFICATIONS_ENABLED="true"

# Shop Operational Configuration
NEXT_PUBLIC_SHOP_NAME="homemart4u"
NEXT_PUBLIC_SHOP_PHONE="+91 90355 26638"
NEXT_PUBLIC_SHOP_PHONE_NUMBER="9035526638"
NEXT_PUBLIC_SHOP_EMAIL="support.homemart4u@gmail.com"
NEXT_PUBLIC_SHOP_ADDRESS="Srinivaspur Road, Mulbagal 563131"
NEXT_PUBLIC_SHOP_LAT="13.1645"
NEXT_PUBLIC_SHOP_LNG="78.3952"

# Business Delivery Constants (in minor units: metres & paise)
NEXT_PUBLIC_FREE_DELIVERY_METERS="3000"
NEXT_PUBLIC_DELIVERY_RATE_PER_100M_PAISE="150"
NEXT_PUBLIC_COD_FEE_PAISE="700"
NEXT_PUBLIC_MIN_QUALIFYING_MEAT_GRAMS="0"
NEXT_PUBLIC_TARGET_DELIVERY_MINUTES="20"
