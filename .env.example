# Fresh Chicken Platform Environment Configuration Example
# Copy to .env for local development

# Database Connection (SQLite default for local dev; PostgreSQL supported for production)
DATABASE_URL="file:./dev.db"

# Authentication Secret (Strong random secret for JWT signing)
AUTH_SECRET="replace_with_a_strong_random_secret"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
ORDER_SIMULATION_ENABLED="false"
PAYMENTS_ENABLED="true"
MARKETING_NOTIFICATIONS_ENABLED="true"

# Shop Operational Configuration
NEXT_PUBLIC_SHOP_NAME="Fresh Chicken"
NEXT_PUBLIC_SHOP_PHONE="+91 98450 12345"
NEXT_PUBLIC_SHOP_ADDRESS="Main Bazaar Road, Near Clock Tower, Mulbagal, Karnataka 563131"
NEXT_PUBLIC_SHOP_LAT="13.1645"
NEXT_PUBLIC_SHOP_LNG="78.3952"

# Business Delivery Constants (in minor units: metres & paise)
NEXT_PUBLIC_FREE_DELIVERY_METERS="3000"
NEXT_PUBLIC_DELIVERY_RATE_PER_100M_PAISE="150"
NEXT_PUBLIC_COD_FEE_PAISE="700"
NEXT_PUBLIC_MIN_QUALIFYING_MEAT_GRAMS="0"
NEXT_PUBLIC_TARGET_DELIVERY_MINUTES="20"
