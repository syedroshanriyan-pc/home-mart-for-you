# Database Connection (PostgreSQL connection string)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Authentication Secret (Strong random secret for JWT signing)
AUTH_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"

# Admin Initial Provisioning (Keep confidential and set secure unique values)
ADMIN_MOBILE=""
ADMIN_EMAIL=""
ADMIN_PASSWORD="set_strong_admin_password_here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
ORDER_SIMULATION_ENABLED="false"
PAYMENTS_ENABLED="true"
MARKETING_NOTIFICATIONS_ENABLED="true"

# Shop Operational Configuration
NEXT_PUBLIC_SHOP_NAME="homemart4u"
NEXT_PUBLIC_SHOP_PHONE="+91 98765 43210"
NEXT_PUBLIC_SHOP_PHONE_NUMBER="9876543210"
NEXT_PUBLIC_SHOP_EMAIL="support@example.com"
NEXT_PUBLIC_SHOP_ADDRESS="Main Market Road, City, State 560001"
NEXT_PUBLIC_SHOP_LAT="12.9716"
NEXT_PUBLIC_SHOP_LNG="77.5946"

# Customer Support Hotline Configuration
SUPPORT_PHONE_NUMBER="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_PHONE_NUMBER="+91 98765 43210"

# UPI Payment Gateway Configuration
UPI_VPA="syedroshanriyan@okaxis"
UPI_MERCHANT_NAME="homemart4u"
NEXT_PUBLIC_UPI_MERCHANT_NAME="homemart4u"

# Split Deployment Settings (Frontend on Vercel, Backend on Render)
# Set RENDER_BACKEND_URL in Vercel to proxy /api requests to Render
RENDER_BACKEND_URL="https://homemart4u-backend.onrender.com"
# Set FRONTEND_URL and ALLOWED_ORIGINS in Render to allow requests from Vercel
FRONTEND_URL="https://homemart4u.vercel.app"
ALLOWED_ORIGINS="https://homemart4u.vercel.app,http://localhost:3000"
