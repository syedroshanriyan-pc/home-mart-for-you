# =============================================================================
# HOMEMART4U BACKEND — ENVIRONMENT VARIABLES TEMPLATE (RENDER)
# Copy to .env on Render Web Service
# =============================================================================

PORT=10000
NODE_ENV=production

# Supabase PostgreSQL Database Connections
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Authentication & Session Security (Min 32 characters)
AUTH_SECRET=""

# Administrator Account
ADMIN_MOBILE=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cross-Origin Resource Sharing (CORS) & CSRF Whitelist
FRONTEND_URL="https://your-frontend.vercel.app"
ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://homemart4u.in"

# Authorized Merchant UPI Payment Configuration
UPI_VPA="7975137618@okbizaxis"
UPI_PAYEE_NAME="Fresh Chicken Centre"
NEXT_PUBLIC_UPI_MERCHANT_NAME="Fresh Chicken Centre"
UPI_MCC="5422"
PAYMENTS_ENABLED="true"
PAYMENT_WEBHOOK_SECRET=""

# Meta WhatsApp Business Platform Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
